{#
/**
 * @file
 * Default theme implementation to display a region.
 *
 * Available variables:
 * - content: The content for this region, typically blocks.
 * - attributes: HTML attributes for the region <div>.
 * - region: The name of the region variable as defined in the theme's
 *   .info.yml file.
 *
 * @see template_preprocess_region()
 *
 * @ingroup themeable
 */
#}
{% if content %}
  {{ attach_library('koan/Section') }}

  {% set background_image_url = '/' ~ directory ~ '/public/image.jpg' %}

  {% set content %}
    <div class="switcher" style="--measure: 30ch;">
      <div>
        {{ elements.koan_site_branding }}
      </div>
      <div>
        {{ elements.koan_account_menu }}
      </div>
    </div>
  {% endset %}

  {% include '@organisms/Section/Section.twig' with {
    first_component: true,
    scheme: "dark",
    align_items: "center",
    background_image_url: background_image_url,
    bg_tint: true,
    brow_data: false,
    heading: false,
    text: false,
    button_data: false,
    content_layout: "center stack",
    content_styles: [],
    content_data: content,
  } %}
{% endif %}
