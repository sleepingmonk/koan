{
  "name": "koan",
  "version": "2.0.0",
  "description": "Koan is a component library and a base theme for Drupal built by sleepingmonk.",
  "main": "main.js",
  "devDependencies": {
    "@storybook/addon-docs": "^9.1.3",
    "@storybook/html-vite": "^9.1.3",
    "cssjson-cli": "^1.0.1",
    "prettier": "^3.6.2",
    "storybook": "^9.1.3",
    "svg-sprite": "^2.0.4",
    "twing": "^7.2.1",
    "vite": "^7.1.3",
    "vite-plugin-twig-drupal": "^1.6.2"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "scheme": "cssjson stories/css/scheme-default.css -o stories/assets/scheme.json && cssjson -h",
    "sprite": "svg-sprite -s --symbol-dest public/ --symbol-sprite icons.svg stories/assets/icons/*.svg && node stories/assets/iconsJSON.js stories/assets/icons",
    "storybook": "source $HOME/.nvm/nvm.sh && nvm use && storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
